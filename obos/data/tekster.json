   "lag": [
    {
     "lag": "Strømsgodset",
     "sporsmal": "Hvorfor har Strømsgodset 85 % sjanse for direkte opprykk?",
     "hvorfor": "Strømsgodset ligger ett poeng foran Haugesund på tredjeplassen og er litt sterkere ifølge modellen (7,0 mot 6,6). Kongsvinger er også med i kampen om de to opprykksplassene. Strømsgodset har også et tøffere restprogram: motstanderne har i snitt 21 % vinnersjanse, mot 15 % for Haugesund.\n\nI simuleringene ender Strømsgodset i snitt på 66 poeng mot 66 for Haugesund, og rykker direkte opp i 85 % av dem.",
     "kamper": "Disse kampene påvirker Strømsgodsets opprykkssjanse mest. Nå: 85 %\n\nStrømmen mot Strømsgodset, runde 28, søndag 25. okt\nSeier: 92 % (+7 prosentpoeng)\nUavgjort: 73 % (−12 prosentpoeng)\nTap: 61 % (−24 prosentpoeng)\n\nStrømsgodset mot Moss, runde 29, søndag 1. nov\nSeier: 91 % (+6 prosentpoeng)\nUavgjort: 72 % (−13 prosentpoeng)\nTap: 62 % (−23 prosentpoeng)\n\nStabæk mot Strømsgodset, runde 30, søndag 8. nov\nSeier: 96 % (+11 prosentpoeng)\nUavgjort: 83 % (−2 prosentpoeng)\nTap: 74 % (−11 prosentpoeng)"
    },
    {
     "lag": "Haugesund",
     "sporsmal": "Hvorfor har Haugesund 73 % sjanse for direkte opprykk?",
     "hvorfor": "Haugesund har like mange poeng som Kongsvinger på andreplassen og er litt sterkere ifølge modellen (6,6 mot 6,3). Haugesund har også et lettere restprogram: motstanderne har i snitt 15 % vinnersjanse, mot 31 % for Kongsvinger.\n\nI simuleringene ender Haugesund i snitt på 66 poeng mot 64 for Kongsvinger, og rykker direkte opp i 73 % av dem.",
     "kamper": "Disse kampene påvirker Haugesunds opprykkssjanse mest. Nå: 73 %\n\nHaugesund mot Hødd, runde 28, søndag 25. okt\nSeier: 79 % (+6 prosentpoeng)\nUavgjort: 53 % (−20 prosentpoeng)\nTap: 36 % (−37 prosentpoeng)\n\nÅsane mot Haugesund, runde 29, søndag 1. nov\nSeier: 82 % (+9 prosentpoeng)\nUavgjort: 59 % (−14 prosentpoeng)\nTap: 42 % (−31 prosentpoeng)\n\nHaugesund mot Odd, runde 30, søndag 8. nov\nSeier: 86 % (+13 prosentpoeng)\nUavgjort: 64 % (−9 prosentpoeng)\nTap: 47 % (−26 prosentpoeng)"
    },
    {
     "lag": "Kongsvinger",
     "sporsmal": "Hvorfor har Kongsvinger 42 % sjanse for direkte opprykk?",
     "hvorfor": "Kongsvinger har like mange poeng som Haugesund på tredjeplassen og er litt svakere ifølge modellen (6,3 mot 6,6). Kongsvinger har også et tøffere restprogram: motstanderne har i snitt 31 % vinnersjanse, mot 15 % for Haugesund.\n\nI simuleringene ender Kongsvinger i snitt på 64 poeng mot 66 for Haugesund, og rykker direkte opp i 42 % av dem.",
     "kamper": "Disse kampene påvirker Kongsvingers opprykkssjanse mest. Nå: 42 %\n\nSogndal mot Kongsvinger, runde 28, søndag 25. okt\nSeier: 58 % (+16 prosentpoeng)\nUavgjort: 28 % (−14 prosentpoeng)\nTap: 17 % (−25 prosentpoeng)\n\nBryne mot Kongsvinger, runde 30, søndag 8. nov\nSeier: 64 % (+22 prosentpoeng)\nUavgjort: 35 % (−7 prosentpoeng)\nTap: 23 % (−19 prosentpoeng)\n\nKongsvinger mot Stabæk, runde 29, mandag 2. nov\nSeier: 62 % (+20 prosentpoeng)\nUavgjort: 33 % (−9 prosentpoeng)\nTap: 21 % (−21 prosentpoeng)"
    }
