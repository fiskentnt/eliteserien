   "lag": [
    {
     "lag": "Bodø/Glimt",
     "sporsmal": "Hvorfor har Bodø/Glimt 69 % sjanse for gull?",
     "hvorfor": "Bodø/Glimt har like mange poeng som Viking på andreplassen og er litt sterkere ifølge modellen (7,4 mot 6,7). Bodø/Glimt har også et lettere restprogram: motstanderne har i snitt 15 % vinnersjanse, mot 24 % for Viking.\n\nI simuleringene ender Bodø/Glimt i snitt på 72 poeng mot 69 for Viking, og vinner serien i 69 % av dem.",
     "kamper": "Disse kampene påvirker Bodø/Glimts gullsjanse mest. Nå: 69 %\n\nBodø/Glimt mot Viking, runde 25, fredag 30. okt\nSeier: 87 % (+18 prosentpoeng)\nUavgjort: 63 % (−6 prosentpoeng)\nTap: 33 % (−36 prosentpoeng)\n\nBodø/Glimt mot Vålerenga, runde 12, lørdag 24. okt\nSeier: 72 % (+3 prosentpoeng)\nUavgjort: 55 % (−14 prosentpoeng)\nTap: 46 % (−23 prosentpoeng)\n\nBodø/Glimt mot KFUM Oslo, runde 28, lørdag 28. nov\nSeier: 72 % (+3 prosentpoeng)\nUavgjort: 56 % (−13 prosentpoeng)\nTap: 48 % (−21 prosentpoeng)"
    },
    {
     "lag": "Viking",
     "sporsmal": "Hvorfor har Viking 31 % sjanse for gull?",
     "hvorfor": "Viking har like mange poeng som serieleder Bodø/Glimt og er litt svakere ifølge modellen (6,7 mot 7,4). Viking har også et tøffere restprogram: motstanderne har i snitt 24 % vinnersjanse, mot 15 % for Bodø/Glimt.\n\nI simuleringene ender Viking i snitt på 69 poeng mot 72 for Bodø/Glimt, og vinner serien i 31 % av dem.",
     "kamper": "Disse kampene påvirker Vikings gullsjanse mest. Nå: 31 %\n\nBodø/Glimt mot Viking, runde 25, fredag 30. okt\nSeier: 67 % (+36 prosentpoeng)\nUavgjort: 37 % (+6 prosentpoeng)\nTap: 13 % (−18 prosentpoeng)\n\nBodø/Glimt mot Vålerenga, runde 12, lørdag 24. okt\nBodø/Glimt vinner: 28 % (−3 prosentpoeng)\nUavgjort: 45 % (+14 prosentpoeng)\nVålerenga vinner: 54 % (+23 prosentpoeng)\n\nBodø/Glimt mot KFUM Oslo, runde 28, lørdag 28. nov\nBodø/Glimt vinner: 28 % (−3 prosentpoeng)\nUavgjort: 44 % (+13 prosentpoeng)\nKFUM Oslo vinner: 52 % (+21 prosentpoeng)"
    }
